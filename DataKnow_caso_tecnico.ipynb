    "if full_rolling_evaluation_df.empty:\n",
    "    print(\"No hay datos disponibles para la evaluación en el DataFrame completo.\")\n",
    "else:\n",
    "    # Filtrar solo las filas donde tenemos valores reales para comparar (para evitar errores con NaN)\n",
    "    # Corrección de typo: 'full_rolling_evaluation_evaluation_df' -> 'full_rolling_evaluation_df'\n",
    "    eval_df_for_daily_metrics = full_rolling_evaluation_df.dropna(subset=['Price_Y', 'Price_Z', 'Price_Equipo1', 'Price_Equipo2']).copy()\n",
    "\n",
    "    if eval_df_for_daily_metrics.empty:\n",
    "        print(\"No hay datos reales para comparar y calcular métricas diarias.\")\n",
    "    else:\n",
    "        # Obtener todas las fechas únicas presentes en el DataFrame de evaluación\n",
    "        unique_dates = eval_df_for_daily_metrics['Date'].unique()\n",
    "        unique_dates = np.sort(unique_dates) # Corrección aquí: usar np.sort() para ordenar\n",
    "\n",
    "        # DataFrame para almacenar todas las métricas diarias\n",
    "        daily_metrics = []\n",
    "\n",
    "        print(\"\\n--- Métricas de Evaluación Día por Día ---\")\n",
    "        for date in unique_dates:\n",
    "            evaluation_day_df = eval_df_for_daily_metrics[\n",
    "                eval_df_for_daily_metrics['Date'] == date\n",
    "            ].copy()\n",
    "\n",
    "            if evaluation_day_df.empty:\n",
    "                continue # Esto no debería ocurrir si unique_dates viene de eval_df_for_daily_metrics\n",
    "\n",
    "            # Calcular MSE y MAPE para Price_Y\n",
    "            mse_y = mean_squared_error(evaluation_day_df['Price_Y'], evaluation_day_df['Price_Y_forecast'])\n",
    "            mape_y = mean_absolute_percentage_error(evaluation_day_df['Price_Y'], evaluation_day_df['Price_Y_forecast']) * 100\n",
    "\n",
    "            # Calcular MSE y MAPE para Price_Z\n",
    "            mse_z = mean_squared_error(evaluation_day_df['Price_Z'], evaluation_day_df['Price_Z_forecast'])\n",
    "            mape_z = mean_absolute_percentage_error(evaluation_day_df['Price_Z'], evaluation_day_df['Price_Z_forecast']) * 100\n",
    "\n",
    "            # Calcular MSE y MAPE para Price_Equipo1\n",
    "            mse_eq1 = mean_squared_error(evaluation_day_df['Price_Equipo1'], evaluation_day_df['Price_Equipo1_forecast'])\n",
    "            mape_eq1 = mean_absolute_percentage_error(evaluation_day_df['Price_Equipo1'], evaluation_day_df['Price_Equipo1_forecast']) * 100\n",
    "\n",
    "            # Calcular MSE y MAPE para Price_Equipo2\n",
    "            mse_eq2 = mean_squared_error(evaluation_day_df['Price_Equipo2'], evaluation_day_df['Price_Equipo2_forecast'])\n",
    "            mape_eq2 = mean_absolute_percentage_error(evaluation_day_df['Price_Equipo2'], evaluation_day_df['Price_Equipo2_forecast']) * 100\n",
    "\n",
    "            # Almacenar los resultados\n",
    "            daily_metrics.append({\n",
    "                'Date': pd.Timestamp(date).strftime('%Y-%m-%d'), # Corrección: usar pd.Timestamp() explícitamente\n",
    "                'Price_Y_MSE': f'{mse_y:.2f}',\n",
    "                'Price_Y_MAPE': f'{mape_y:.2f}%',\n",
    "                'Price_Z_MSE': f'{mse_z:.2f}',\n",
    "                'Price_Z_MAPE': f'{mape_z:.2f}%',\n",
    "                'Price_Equipo1_MSE': f'{mse_eq1:.2f}',\n",
    "                'Price_Equipo1_MAPE': f'{mape_eq1:.2f}%',\n",
    "                'Price_Equipo2_MSE': f'{mse_eq2:.2f}',\n",
    "                'Price_Equipo2_MAPE': f'{mape_eq2:.2f}%'\n",
    "            })\n",
    "\n",
    "        # Mostrar la tabla de métricas diarias\n",
    "        daily_metrics_df = pd.DataFrame(daily_metrics)\n",
    "        display(daily_metrics_df)"
   ]
