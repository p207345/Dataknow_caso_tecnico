   "source": [
    "import matplotlib.cm as cm # For color maps\n",
    "\n",
    "# Ordenar por fecha para asegurar que las ventanas sean consecutivas\n",
    "historico_clean = historico_clean.sort_values(by='Date').reset_index(drop=True)\n",
    "\n",
    "# Determinar el rango de fechas\n",
    "min_date = historico_clean['Date'].min()\n",
    "max_date = historico_clean['Date'].max()\n",
    "\n",
    "# Definir el tamaño de la ventana en años\n",
    "window_years = 5\n",
    "\n",
    "# Aproximar el número de ventanas para la paleta de colores\n",
    "n_windows = (max_date.year - min_date.year) // window_years + 2 # +2 para asegurar suficientes colores\n",
    "colors_y = cm.Blues(np.linspace(0.4, 0.9, n_windows)) # Diferentes tonos de azul para Price_Y\n",
    "colors_z = cm.Oranges(np.linspace(0.4, 0.9, n_windows)) # Diferentes tonos de naranja para Price_Z\n",
    "\n",
    "plt.figure(figsize=(15, 8))\n",
    "window_count = 0\n",
    "\n",
    "# Iterar sobre las ventanas de n años\n",
    "start_year = min_date.year\n",
    "while start_year <= max_date.year + window_years: # Ajustar el bucle para incluir la última ventana parcial\n",
    "    end_year = start_year + window_years - 1\n",
    "    end_date_window = pd.Timestamp(year=end_year, month=12, day=31)\n",
    "\n",
    "    # Filtrar el DataFrame para la ventana actual\n",
    "    current_window_df = historico_clean[(historico_clean['Date'].dt.year >= start_year) &\n",
    "                                        (historico_clean['Date'] <= end_date_window)].copy() # Usar .copy() para evitar SettingWithCopyWarning\n",
    "\n",
    "    # Si no hay datos en la ventana actual o la ventana es demasiado pequeña, pasar a la siguiente\n",
    "    if current_window_df.empty or len(current_window_df) < 2:\n",
    "        start_year += window_years\n",
    "        continue\n",
    "\n",
    "    # Calcular el índice de fecha relativo para esta ventana\n",
    "    current_window_df['relative_date_index'] = (current_window_df['Date'] - current_window_df['Date'].min()).dt.days\n",
    "\n",
    "    # Ajustar end_year_display para la etiqueta del gráfico\n",
    "    if current_window_df['Date'].max().year > max_date.year:\n",
    "        end_year_display = max_date.year\n",
    "    else:\n",
    "        end_year_display = current_window_df['Date'].max().year\n",
    "\n",
    "    label_y = f'Price_Y ({start_year}-{end_year_display})'\n",
    "    label_z = f'Price_Z ({start_year}-{end_year_display})'\n",
    "\n",
    "    # Asegurarse de que no nos salimos del índice de colores\n",
    "    color_idx = window_count % n_windows\n",
    "\n",
    "    sns.lineplot(x='relative_date_index', y='Price_Y', data=current_window_df, color=colors_y[color_idx], label=label_y)\n",
    "    sns.lineplot(x='relative_date_index', y='Price_Z', data=current_window_df, color=colors_z[color_idx], label=label_z, linestyle='--') # Usar linestyle para Price_Z\n",
    "\n",
    "    window_count += 1\n",
    "    start_year += window_years\n",
    "\n",
    "plt.title('Tendencia de Precios de Insumos Y y Z por Ventanas Temporales Superpuestas (Índice Relativo)', fontsize=16)\n",
    "plt.xlabel('Índice de Fecha Relativo (días desde el inicio de la ventana)', fontsize=12)\n",
    "plt.ylabel('Precio', fontsize=12)\n",
    "plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left', borderaxespad=0.) # Colocar la leyenda fuera del gráfico\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
