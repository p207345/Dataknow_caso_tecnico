    "# Definir variables independientes (X) y dependiente (y) para Price_Equipo2 vs Price_Y y Price_Z\n",
    "X_multi_eq2 = historico_clean[['Price_Y', 'Price_Z']]\n",
    "y_multi_eq2 = historico_clean['Price_Equipo2']\n",
    "\n",
    "# Dividir los datos en conjuntos de entrenamiento y prueba\n",
    "X_train_multi_eq2, X_test_multi_eq2, y_train_multi_eq2, y_test_multi_eq2 = train_test_split(X_multi_eq2, y_multi_eq2, test_size=0.2, random_state=42)\n",
    "\n",
    "# Añadir una constante a las variables independientes para Statsmodels OLS\n",
    "X_train_sm_multi_eq2 = sm.add_constant(X_train_multi_eq2)\n",
    "X_test_sm_multi_eq2 = sm.add_constant(X_test_multi_eq2)\n",
    "\n",
    "# Ajustar el modelo OLS\n",
    "model_sm_multi_eq2 = sm.OLS(y_train_multi_eq2, X_train_sm_multi_eq2)\n",
    "results_sm_multi_eq2 = model_sm_multi_eq2.fit()\n",
    "\n",
    "# Imprimir el resumen del modelo\n",
    "print(\"Statsmodels OLS - Price_Equipo2 vs Price_Y y Price_Z:\")\n",
    "print(results_sm_multi_eq2.summary())\n",
    "\n",
    "# Obtener coeficientes e intercepto para formar la ecuación\n",
    "const_multi_eq2 = results_sm_multi_eq2.params['const']\n",
    "coef_y_multi_eq2 = results_sm_multi_eq2.params['Price_Y']\n",
    "coef_z_multi_eq2 = results_sm_multi_eq2.params['Price_Z']\n",
    "\n",
    "print(f\"\\nEcuación de Regresión: Price_Equipo2 = {const_multi_eq2:.2f} + {coef_y_multi_eq2:.2f} * Price_Y + {coef_z_multi_eq2:.2f} * Price_Z\")\n",
    "\n",
    "# Predecir sobre el conjunto de prueba\n",
    "y_pred_sm_multi_eq2 = results_sm_multi_eq2.predict(X_test_sm_multi_eq2)\n",
    "\n",
    "# Calcular R-squared para las predicciones del conjunto de prueba\n",
    "r2_sm_multi_eq2 = r2_score(y_test_multi_eq2, y_pred_sm_multi_eq2)\n",
