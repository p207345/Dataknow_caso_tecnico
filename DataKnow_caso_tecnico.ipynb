   "source": [
    "training_window_years = 5 # Se entrena con 3 años de datos históricos\n",
    "forecast_horizon_days = 30 # Días a pronosticar en cada 'chunk' (puedes ajustar a 30, 90, etc.)\n",
    "time_steps = 60 # Definido explícitamente según el contexto de las LSTMs\n",
    "\n",
    "# Asegurarse de que 'Date' sea datetime y ordenar\n",
    "historico_clean['Date'] = pd.to_datetime(historico_clean['Date'])\n",
    "historico_clean = historico_clean.sort_values(by='Date').reset_index(drop=True)\n",
    "\n",
    "# --- Definición de los años a evaluar con pronósticos rodantes ---\n",
    "# Lista completa de todos los años que deseas evaluar\n",
    "all_available_evaluation_years = list(range(historico_clean['Date'].dt.year.min() + training_window_years, historico_clean['Date'].dt.year.max() + 2))\n",
    "\n",
    "# Filtrar los años que ya han sido procesados y cargados desde el checkpoint\n",
    "evaluation_years = [year for year in all_available_evaluation_years if year not in processed_years]\n",
    "\n",
    "print(f\"Tamaño de la ventana de entrenamiento: {training_window_years} años\")\n",
    "print(f\"Horizonte de pronóstico por chunk: {forecast_horizon_days} días\")\n",
    "print(f\"Pasos de tiempo (time_steps) para LSTM: {time_steps}\")\n",
    "\n",
    "if not evaluation_years:\n",
    "    print(\"Todos los años de evaluación ya han sido procesados y cargados desde el checkpoint.\")\n",
    "else:\n",
    "    print(f\"Años a evaluar con pronóstico (restantes): {evaluation_years}\")\n",
    "\n",
    "print(\"-\" * 50)"
   ]
