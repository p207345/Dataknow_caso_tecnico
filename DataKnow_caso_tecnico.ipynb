   "source": [
    "from tensorflow.keras.models import load_model\n",
    "\n",
    "# Obtener los datos más recientes para el entrenamiento final\n",
    "# Asegúrate de que `dynamic_historico_for_training` contenga los datos más actualizados, incluyendo predicciones previas.\n",
    "final_train_df = dynamic_historico_for_training.copy()\n",
    "\n",
    "# --- Entrenar y guardar el modelo para Price_Y ---\n",
    "print(\"Entrenando modelo final para Price_Y...\")\n",
    "final_forecasted_y, final_scaler_y = run_lstm_forecast_for_rolling_window(\n",
    "    train_data_df=final_train_df,\n",
    "    target_variable='Price_Y',\n",
    "    time_steps=time_steps,\n",
    "    forecast_horizon_days=forecast_horizon_days # Podrías ajustar esto si quieres un pronóstico diferente al guardado\n",
    ")\n",
    "\n",
    "# Guardar el modelo entrenado (el modelo es retornado por build_lstm_model dentro de run_lstm_forecast_for_rolling_window)\n",
    "# Necesitamos una pequeña modificación en run_lstm_forecast_for_rolling_window para que retorne el modelo.\n",
    "# Por simplicidad aquí, re-construiremos y entrenaremos el modelo directamente para Price_Y\n",
    "\n",
    "# Escalar los datos\n",
    "target_series_y = final_train_df['Price_Y'].values.reshape(-1, 1)\n",
    "scaler_y = MinMaxScaler(feature_range=(0, 1))\n",
    "scaled_target_series_y = scaler_y.fit_transform(target_series_y)\n",
    "\n",
    "# Crear secuencias\n",
    "X_final_y, y_final_y = create_sequences(scaled_target_series_y, time_steps, forecast_horizon_days)\n",
    "X_final_y = X_final_y.reshape(X_final_y.shape[0], X_final_y.shape[1], 1)\n",
    "\n",
    "# Construir y entrenar el modelo\n",
    "final_model_y = build_lstm_model((time_steps, 1), forecast_horizon_days)\n",
    "final_model_y.fit(X_final_y, y_final_y, epochs=200, batch_size=64, verbose=0)\n",
    "\n",
    "# Guardar el modelo en formato Keras nativo\n",
    "model_path_y = data_path/'lstm_model_price_y.keras'\n",
    "final_model_y.save(model_path_y)\n",
    "print(f\"Modelo Price_Y guardado en: {model_path_y}\")\n",
    "\n",
    "# --- Entrenar y guardar el modelo para Price_Z ---\n",
    "print(\"Entrenando modelo final para Price_Z...\")\n",
    "target_series_z = final_train_df['Price_Z'].values.reshape(-1, 1)\n",
    "scaler_z = MinMaxScaler(feature_range=(0, 1))\n",
    "scaled_target_series_z = scaler_z.fit_transform(target_series_z)\n",
    "\n",
    "X_final_z, y_final_z = create_sequences(scaled_target_series_z, time_steps, forecast_horizon_days)\n",
    "X_final_z = X_final_z.reshape(X_final_z.shape[0], X_final_z.shape[1], 1)\n",
    "\n",
    "final_model_z = build_lstm_model((time_steps, 1), forecast_horizon_days)\n",
    "final_model_z.fit(X_final_z, y_final_z, epochs=200, batch_size=64, verbose=0)\n",
    "\n",
    "model_path_z = data_path/'lstm_model_price_z.keras'\n",
    "final_model_z.save(model_path_z)\n",
    "print(f\"Modelo Price_Z guardado en: {model_path_z}\")\n",
    "\n",
    "print(\"Recuerda que también necesitas guardar el scaler si lo vas a usar para nuevas predicciones.\")\n",
