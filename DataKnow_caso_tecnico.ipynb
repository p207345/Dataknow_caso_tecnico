   "source": [
    "# all_rolling_forecasts y dynamic_historico_for_training son ahora manejados por la celda de checkpoint\n",
    "\n",
    "if not evaluation_years:\n",
    "    print(\"Todos los años de evaluación ya han sido procesados y cargados desde el checkpoint. No se ejecutarán nuevos pronósticos.\")\n",
    "else:\n",
    "    for evaluation_year in evaluation_years:\n",
    "        print(f\"---------- Iniciando pronóstico rodante para el año: {evaluation_year} ----------\")\n",
    "\n",
    "        # Lista temporal para almacenar los pronósticos de los chunks del año actual\n",
    "        current_run_forecasts_chunk = []\n",
    "\n",
    "        # Fechas de inicio y fin del periodo total de pronóstico que queremos cubrir para el año actual\n",
    "        rolling_forecast_eval_start_date = pd.Timestamp(f'{evaluation_year}-01-01')\n",
    "        rolling_forecast_eval_end_date   = pd.Timestamp(f'{evaluation_year}-12-31')\n",
    "\n",
    "        # La fecha mínima en `historico_clean` para que sea posible una ventana de entrenamiento completa para el primer chunk\n",
    "        # ajustado para usar dynamic_historico_for_training si ya tiene datos adicionales\n",
    "        min_date_for_first_train_end = dynamic_historico_for_training['Date'].min() + pd.DateOffset(years=training_window_years) - pd.DateOffset(days=1)\n",
    "\n",
    "        # Verificar si hay suficientes datos históricos para el primer entrenamiento del año\n",
    "        if (rolling_forecast_eval_start_date - pd.DateOffset(days=1)) < min_date_for_first_train_end:\n",
    "            print(f\"Advertencia: No hay suficientes datos históricos (reales/pronosticados) para entrenar el pronóstico inicial del año {evaluation_year}.\")\n",
    "            print(f\"Se requiere datos hasta {(rolling_forecast_eval_start_date - pd.DateOffset(days=1)).strftime('%Y-%m-%d')} para un entrenamiento de {training_window_years} años.\")\n",
    "            print(f\"La fecha de inicio de datos históricos disponibles es {dynamic_historico_for_training['Date'].min().strftime('%Y-%m-%d')}. Saltando evaluación para el año {evaluation_year}.\\n\")\n",
    "            continue\n",
    "\n",
    "        current_prediction_start_date = rolling_forecast_eval_start_date\n",
    "\n",
    "        while current_prediction_start_date <= rolling_forecast_eval_end_date:\n",
    "            print(f\"  Generando pronóstico para el chunk que inicia en: {current_prediction_start_date.strftime('%Y-%m-%d')}\")\n",
    "\n",
    "            # La ventana de entrenamiento termina el día anterior al inicio de la predicción del chunk\n",
    "            train_end_date = current_prediction_start_date - pd.DateOffset(days=1)\n",
    "            train_start_date = train_end_date - pd.DateOffset(years=training_window_years) + pd.DateOffset(days=1)\n",
    "\n",
    "            # Asegurar que la fecha de inicio del entrenamiento no sea anterior a la fecha mínima de los datos\n",
    "            if train_start_date < dynamic_historico_for_training['Date'].min():\n",
    "                train_start_date = dynamic_historico_for_training['Date'].min()\n",
    "\n",
    "            # Filtrar datos de entrenamiento desde el dynamic_historico_for_training\n",
    "            train_df = dynamic_historico_for_training[\n",
    "                (dynamic_historico_for_training['Date'] >= train_start_date) &\n",
    "                (dynamic_historico_for_training['Date'] <= train_end_date)\n",
    "            ].copy()\n",
    "\n",
    "            # Ajuste de la condición de datos insuficientes\n",
    "            if train_df.empty or len(train_df) < time_steps + forecast_horizon_days:\n",
    "                print(f\"  Datos insuficientes para entrenar con ventana que termina en {train_end_date.strftime('%Y-%m-%d')}. Se requiere al menos {time_steps + forecast_horizon_days} puntos de datos. Saltando este chunk.\\n\")\n",
    "                current_prediction_start_date += pd.DateOffset(days=forecast_horizon_days)\n",
    "                continue\n",
    "\n",
    "            # --- Pronóstico para Price_Y ---\n",
    "            forecasted_y, _ = run_lstm_forecast_for_rolling_window(\n",
    "                train_data_df=train_df,\n",
    "                target_variable='Price_Y',\n",
    "                time_steps=time_steps,\n",
    "                forecast_horizon_days=forecast_horizon_days\n",
    "            )\n",
    "\n",
    "            # --- Pronóstico para Price_Z ---\n",
    "            forecasted_z, _ = run_lstm_forecast_for_rolling_window(\n",
    "                train_data_df=train_df,\n",
    "                target_variable='Price_Z',\n",
    "                time_steps=time_steps,\n",
    "                forecast_horizon_days=forecast_horizon_days\n",
    "            )\n",
    "\n",
    "            # Crear fechas para el pronóstico del chunk actual\n",
    "            forecast_dates_chunk = pd.date_range(start=current_prediction_start_date, periods=forecast_horizon_days, freq='D')\n",
    "\n",
    "            # Recortar el chunk de fechas si excede el final del periodo de evaluación para el año actual\n",
    "            forecast_dates_chunk = forecast_dates_chunk[forecast_dates_chunk <= rolling_forecast_eval_end_date]\n",
    "\n",
    "            if forecast_dates_chunk.empty:\n",
    "                # No quedan más fechas por pronosticar en el período de evaluación actual\n",
    "                break\n",
    "\n",
    "            # Crear DataFrame temporal para los pronósticos de este chunk\n",
    "            current_chunk_forecast_df = pd.DataFrame({\n",
    "                'Date': forecast_dates_chunk,\n",
    "                'Train_End_Date': train_end_date, # Para referencia, qué ventana de entrenamiento generó esto\n",
    "                'Price_Y_forecast': forecasted_y[:len(forecast_dates_chunk)], # Asegurarse de tomar solo la longitud necesaria\n",
    "                'Price_Z_forecast': forecasted_z[:len(forecast_dates_chunk)] # Asegurarse de tomar solo la longitud necesaria\n",
    "            })\n",
    "\n",
    "            # Aplicar ecuaciones de regresión para Price_Equipo1 y Price_Equipo2\n",
    "            current_chunk_forecast_df['Price_Equipo1_forecast'] = 6.02 + 0.82 * current_chunk_forecast_df['Price_Y_forecast']\n",
    "            current_chunk_forecast_df['Price_Equipo2_forecast'] = 6.61 + 0.36 * current_chunk_forecast_df['Price_Y_forecast'] + 0.34 * current_chunk_forecast_df['Price_Z_forecast']\n",
    "\n",
    "            # *** Parte CRÍTICA: Augmentar dynamic_historico_for_training con los pronósticos ***\n",
    "            # Prepara un DataFrame con las columnas esperadas por dynamic_historico_for_training\n",
    "            predicted_data_for_augmentation = pd.DataFrame({'Date': forecast_dates_chunk})\n",
    "            predicted_data_for_augmentation['Price_Y'] = forecasted_y[:len(forecast_dates_chunk)]\n",
    "            predicted_data_for_augmentation['Price_Z'] = forecasted_z[:len(forecast_dates_chunk)]\n",
    "\n",
    "            # Rellenar otras columnas que existan en historico_clean pero no en los pronósticos con NaN\n",
    "            for col in historico_clean.columns:\n",
    "                if col not in predicted_data_for_augmentation.columns:\n",
    "                    predicted_data_for_augmentation[col] = np.nan\n",
    "\n",
    "            # Concatenar y eliminar duplicados, priorizando los datos más recientes (predicciones)\n",
    "            dynamic_historico_for_training = pd.concat([dynamic_historico_for_training, predicted_data_for_augmentation], ignore_index=True)\n",
    "            dynamic_historico_for_training = dynamic_historico_for_training.sort_values('Date').drop_duplicates(subset=['Date'], keep='last').reset_index(drop=True)\n",
    "\n",
    "            # Unir con datos REALES de historico_clean para el período de pronóstico generado, si están disponibles para evaluación\n",
    "            merged_forecasts_with_actuals = pd.merge(\n",
    "                current_chunk_forecast_df,\n",
    "                historico_clean[['Date', 'Price_Y', 'Price_Z', 'Price_Equipo1', 'Price_Equipo2']],\n",
    "                on='Date',\n",
    "                how='left' # 'left' para mantener todos los pronósticos y añadir reales si existen\n",
    "            )\n",
    "\n",
    "            current_run_forecasts_chunk.append(merged_forecasts_with_actuals)\n",
    "\n",
    "            # Avanzar la fecha de inicio de la próxima predicción por el horizonte del chunk\n",
    "            current_prediction_start_date += pd.DateOffset(days=forecast_horizon_days)\n",
    "\n",
    "        print(f\"---------- Pronóstico rodante completado para el año: {evaluation_year} ----------\\n\")\n",
    "\n",
    "        # Después de procesar un año completo, añadir los chunks a full_rolling_evaluation_df y guardar el checkpoint\n",
    "        if current_run_forecasts_chunk:\n",
    "            new_forecasts_for_year_df = pd.concat(current_run_forecasts_chunk).drop_duplicates(subset='Date').sort_values(by='Date').reset_index(drop=True)\n",
    "            full_rolling_evaluation_df = pd.concat([full_rolling_evaluation_df, new_forecasts_for_year_df]).drop_duplicates(subset='Date').sort_values(by='Date').reset_index(drop=True)\n",
    "            full_rolling_evaluation_df.to_csv(CHECKPOINT_FILE, index=False)\n",
    "            print(f\"Progreso guardado en {CHECKPOINT_FILE} para el año {evaluation_year}.\")\n",
    "            processed_years.add(evaluation_year) # Marcar el año como procesado\n",
    "            current_run_forecasts_chunk = [] # Limpiar para el siguiente año\n",
    "\n",
    "    print(\"Bucle de pronóstico rodante para todos los años completado.\")\n",
    "\n",
    "# Visualización final del DataFrame de evaluación\n",
    "if not full_rolling_evaluation_df.empty:\n",
    "    print(\"DataFrame de evaluación de pronósticos rodantes final creado.\")\n",
    "    display(full_rolling_evaluation_df.head())\n",
    "    display(full_rolling_evaluation_df.tail())\n",
    "else:\n",
    "    print(\"No se generaron pronósticos para los períodos de evaluación especificados.\")"
   ]
  },
