    "# Identificar la última fecha con datos reales en historico_clean\n",
    "last_real_date = historico_clean['Date'].max()\n",
    "\n",
    "# Filtrar el DataFrame de evaluación desde la última fecha real en adelante\n",
    "# Queremos incluir la última fecha real y todas las fechas pronosticadas.\n",
    "forecast_for_powerbi_df = full_rolling_evaluation_df[\n",
    "    full_rolling_evaluation_df['Date'] >= last_real_date\n",
    "].copy()\n",
    "\n",
    "# Crear columnas combinadas (real si existe, de lo contrario pronóstico)\n",
    "forecast_for_powerbi_df['Combined_Price_Y'] = forecast_for_powerbi_df['Price_Y'].fillna(forecast_for_powerbi_df['Price_Y_forecast'])\n",
    "forecast_for_powerbi_df['Combined_Price_Z'] = forecast_for_powerbi_df['Price_Z'].fillna(forecast_for_powerbi_df['Price_Z_forecast'])\n",
    "forecast_for_powerbi_df['Combined_Price_Equipo1'] = forecast_for_powerbi_df['Price_Equipo1'].fillna(forecast_for_powerbi_df['Price_Equipo1_forecast'])\n",
    "forecast_for_powerbi_df['Combined_Price_Equipo2'] = forecast_for_powerbi_df['Price_Equipo2'].fillna(forecast_for_powerbi_df['Price_Equipo2_forecast'])\n",
    "\n",
    "# Seleccionar solo las columnas relevantes para el CSV\n",
    "final_output_df = forecast_for_powerbi_df[[\n",
    "    'Date',\n",
