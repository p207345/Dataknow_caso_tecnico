     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Funciones LSTM (create_sequences, build_lstm_model, predict_multi_step_direct, run_lstm_forecast_for_rolling_window) actualizadas.\n"
     ]
    }
   ],
   "source": [
    "import tensorflow as tf\n",
    "from tensorflow.keras.models import Sequential\n",
    "from tensorflow.keras.layers import LSTM, Dense\n",
    "from sklearn.preprocessing import MinMaxScaler\n",
    "from sklearn.metrics import mean_squared_error, mean_absolute_percentage_error\n",
    "\n",
    "\n",
    "# Reutilizar funciones ya definidas y modificarlas según los requisitos del usuario\n",
    "\n",
    "def create_sequences(data, time_steps, output_sequence_length):\n",
    "    X, y = [], []\n",
    "    # El bucle debe terminar lo suficientemente temprano para que 'y' tenga la longitud completa del pronóstico\n",
    "    for i in range(len(data) - time_steps - output_sequence_length + 1):\n",
    "        X.append(data[i:(i + time_steps), 0])\n",
    "        y.append(data[i + time_steps : i + time_steps + output_sequence_length, 0]) # Ahora 'y' es una secuencia de valores futuros\n",
    "    return np.array(X), np.array(y)\n",
    "\n",
    "def build_lstm_model(input_shape, output_dim):\n",
    "    model = Sequential()\n",
    "    model.add(LSTM(128, return_sequences=True, input_shape=input_shape))\n",
    "    model.add(LSTM(64, return_sequences=False))\n",
    "    model.add(Dense(32, activation='relu'))\n",
    "    model.add(Dense(output_dim))  # La capa de salida predice directamente el horizonte completo\n",
    "\n",
    "    optimizer = tf.keras.optimizers.Adam(learning_rate=0.001) # Tasa de aprendizaje especificada\n",
    "    model.compile(optimizer=optimizer, loss='mean_squared_error')\n",
    "    return model\n",
    "\n",
    "# La función multi_step_forecast se simplifica a una predicción directa\n",
    "def predict_multi_step_direct(model, initial_sequence, scaler):\n",
    "    # initial_sequence debe ser escalado y con la forma (1, time_steps, 1)\n",
    "    initial_sequence_reshaped = initial_sequence.reshape(1, initial_sequence.shape[0], 1)\n",
    "\n",
    "    # El modelo predice todo el horizonte de una vez\n",
    "    scaled_forecast = model.predict(initial_sequence_reshaped, verbose=0)\n",
    "\n",
    "    # Invertir la escala y aplanar para obtener un array 1D\n",
    "    return scaler.inverse_transform(scaled_forecast.reshape(-1, 1)).flatten()\n",
    "\n",
    "# --- Función principal para el pronóstico LSTM en una ventana rodante ---\n",
    "def run_lstm_forecast_for_rolling_window(\n",
    "    train_data_df: pd.DataFrame,\n",
    "    target_variable: str,\n",
    "    time_steps: int,\n",
    "    forecast_horizon_days: int\n",
    "):\n",
    "    \"\"\"\n",
    "    Entrena un modelo LSTM en `train_data_df` para `target_variable` y genera\n",
    "    un pronóstico multi-paso para `forecast_horizon_days`.\n",
    "\n",
    "    Args:\n",
    "        train_data_df (pd.DataFrame): DataFrame de entrenamiento.\n",
    "        target_variable (str): Nombre de la columna a pronosticar (ej. 'Price_Y').\n",
    "        time_steps (int): Número de pasos de tiempo para las secuencias LSTM.\n",
    "        forecast_horizon_days (int): Número de días a pronosticar.\n",
    "\n",
    "    Returns:\n",
    "        tuple: (np.array) Pronósticos desescalados, (MinMaxScaler) scaler usado.\n",
    "    \"\"\"\n",
    "\n",
    "    # Extraer la serie de la variable objetivo y normalizar\n",
    "    target_series = train_data_df[target_variable].values.reshape(-1, 1)\n",
    "    scaler = MinMaxScaler(feature_range=(0, 1))\n",
    "    scaled_target_series = scaler.fit_transform(target_series)\n",
    "\n",
    "    # Crear secuencias de entrenamiento, ahora con la longitud de salida del pronóstico\n",
    "    X_train_lstm, y_train_lstm = create_sequences(scaled_target_series, time_steps, forecast_horizon_days)\n",
    "    X_train_lstm = X_train_lstm.reshape(X_train_lstm.shape[0], X_train_lstm.shape[1], 1)\n",
    "\n",
    "    # Construir y entrenar el modelo LSTM\n",
    "    model = build_lstm_model((time_steps, 1), forecast_horizon_days) # Pasa forecast_horizon_days como output_dim\n",
    "    # Usar las épocas y el batch_size especificados por el usuario\n",
    "    model.fit(X_train_lstm, y_train_lstm, epochs=200, batch_size=64, verbose=0)\n",
    "\n",
    "    # Generar pronóstico multi-paso directamente\n",
    "    last_sequence = scaled_target_series[-time_steps:]\n",
    "    forecasted_values = predict_multi_step_direct(model, last_sequence, scaler) # Usar la nueva función de pronóstico directo\n",
    "\n",
    "    return forecasted_values, scaler\n",
    "\n",
    "print(\"Funciones LSTM (create_sequences, build_lstm_model, predict_multi_step_direct, run_lstm_forecast_for_rolling_window) actualizadas.\")"
   ]
  },
