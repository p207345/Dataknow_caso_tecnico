   "source": [
    "import statsmodels.api as sm\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import mean_squared_error, r2_score\n",
    "from sklearn.linear_model import Lasso, Ridge\n",
    "import numpy as np\n",
    "\n",
    "# Definir variables independientes (X) y dependiente (y) para Price_Equipo1 vs Price_Y\n",
    "X_eq1_y_sm = historico_clean[['Price_Y']]\n",
    "y_eq1_sm = historico_clean['Price_Equipo1']\n",
    "\n",
    "# Dividir los datos en conjuntos de entrenamiento y prueba\n",
    "X_train_eq1_y_sm, X_test_eq1_y_sm, y_train_eq1_y_sm, y_test_eq1_y_sm = train_test_split(X_eq1_y_sm, y_eq1_sm, test_size=0.2, random_state=42)\n",
    "\n",
    "# Añadir una constante a las variables independientes para Statsmodels OLS\n",
    "X_train_sm_eq1_y = sm.add_constant(X_train_eq1_y_sm)\n",
    "X_test_sm_eq1_y = sm.add_constant(X_test_eq1_y_sm)\n",
    "\n",
    "# Ajustar el modelo OLS\n",
    "model_sm_eq1_y = sm.OLS(y_train_eq1_y_sm, X_train_sm_eq1_y)\n",
    "results_sm_eq1_y = model_sm_eq1_y.fit()\n",
    "\n",
    "# Imprimir el resumen del modelo\n",
    "print(\"Statsmodels OLS - Price_Equipo1 vs Price_Y:\")\n",
    "print(results_sm_eq1_y.summary())\n",
    "\n",
    "# Obtener coeficientes e intercepto para formar la ecuación\n",
    "const_eq1_y = results_sm_eq1_y.params['const']\n",
    "coef_y_eq1_y = results_sm_eq1_y.params['Price_Y']\n",
    "\n",
    "print(f\"\\nEcuación de Regresión: Price_Equipo1 = {const_eq1_y:.2f} + {coef_y_eq1_y:.2f} * Price_Y\")\n",
    "\n",
    "# Predecir sobre el conjunto de prueba\n",
    "y_pred_sm_eq1_y = results_sm_eq1_y.predict(X_test_sm_eq1_y)\n",
    "\n",
    "# Calcular R-squared para las predicciones del conjunto de prueba\n",
    "r2_sm_eq1_y = r2_score(y_test_eq1_y_sm, y_pred_sm_eq1_y)\n",
    "print(f\"R-squared (Conjunto de Prueba): {r2_sm_eq1_y:.2f}\")"
   ]
  },
