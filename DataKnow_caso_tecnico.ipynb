   "source": [
    "# Asegurarse de que el DataFrame de evaluación no esté vacío y tenga las columnas necesarias\n",
    "if full_rolling_evaluation_df.empty or 'Price_Equipo1_forecast' not in full_rolling_evaluation_df.columns:\n",
    "    print(\"No hay datos de pronóstico disponibles en 'full_rolling_evaluation_df'.\")\n",
    "else:\n",
    "    # Crear una copia para evitar SettingWithCopyWarning\n",
    "    supplier_forecasts_df = full_rolling_evaluation_df[['Date', 'Price_Equipo1_forecast', 'Price_Equipo2_forecast']].copy()\n",
    "\n",
    "    # --- Definir perfiles de proveedores (ejemplo) ---\n",
    "    # Se asume una desviación estándar para el cálculo del CI\n",
    "    # Z para 95% CI es ~1.96\n",
    "    Z_score_95 = 1.96\n",
    "\n",
    "    # Proveedor A: Precio ligeramente más bajo, variabilidad moderada (ej. 3% del precio)\n",
    "    supplier_forecasts_df['Price_Equipo1_A'] = supplier_forecasts_df['Price_Equipo1_forecast'] * 0.98\n",
    "    supplier_forecasts_df['Price_Equipo2_A'] = supplier_forecasts_df['Price_Equipo2_forecast'] * 0.98\n",
    "    supplier_forecasts_df['Std_Dev_A'] = supplier_forecasts_df['Price_Equipo1_A'] * 0.03 # 3% de variabilidad del precio\n",
    "\n",
    "    # Proveedor B: Precio cercano al pronóstico, variabilidad baja (ej. 2% del precio)\n",
    "    supplier_forecasts_df['Price_Equipo1_B'] = supplier_forecasts_df['Price_Equipo1_forecast'] * 1.00\n",
    "    supplier_forecasts_df['Price_Equipo2_B'] = supplier_forecasts_df['Price_Equipo2_forecast'] * 1.00\n",
    "    supplier_forecasts_df['Std_Dev_B'] = supplier_forecasts_df['Price_Equipo1_B'] * 0.02 # 2% de variabilidad del precio\n",
    "\n",
    "    # Proveedor C: Precio ligeramente más alto, variabilidad muy baja (ej. 1% del precio)\n",
    "    supplier_forecasts_df['Price_Equipo1_C'] = supplier_forecasts_df['Price_Equipo1_forecast'] * 1.02\n",
    "    supplier_forecasts_df['Price_Equipo2_C'] = supplier_forecasts_df['Price_Equipo2_forecast'] * 1.02\n",
    "    supplier_forecasts_df['Std_Dev_C'] = supplier_forecasts_df['Price_Equipo1_C'] * 0.01 # 1% de variabilidad del precio\n",
    "\n",
    "    # --- Calcular Intervalos de Confianza (95%) para cada proveedor y equipo ---\n",
    "    for supplier in ['A', 'B', 'C']:\n",
    "        for equipo in ['Equipo1', 'Equipo2']:\n",
    "            price_col = f'Price_{equipo}_{supplier}'\n",
    "            std_dev_col = f'Std_Dev_{supplier}' # Usamos la misma desviación estándar para ambos equipos por proveedor en este ejemplo\n",
    "\n",
    "            # Límite inferior del CI\n",
    "            supplier_forecasts_df[f'CI_Lower_{equipo}_{supplier}'] = supplier_forecasts_df[price_col] - Z_score_95 * supplier_forecasts_df[std_dev_col]\n",
    "            # Límite superior del CI\n",
    "            supplier_forecasts_df[f'CI_Upper_{equipo}_{supplier}'] = supplier_forecasts_df[price_col] + Z_score_95 * supplier_forecasts_df[std_dev_col]\n",
    "\n",
    "    # --- MÉTRICAS Y RANKING ---\n",
    "    all_supplier_daily_metrics = []\n",
    "\n",
    "    for _, row in supplier_forecasts_df.iterrows():\n",
    "        current_date = row['Date']\n",
    "\n",
    "        for equipo in ['Equipo1', 'Equipo2']:\n",
    "            forecast_price = row[f'Price_{equipo}_forecast']\n",
    "\n",
    "            for supplier_name in ['A', 'B', 'C']:\n",
    "                supplier_price = row[f'Price_{equipo}_{supplier_name}']\n",
    "                ci_lower = row[f'CI_Lower_{equipo}_{supplier_name}']\n",
    "                ci_upper = row[f'CI_Upper_{equipo}_{supplier_name}']\n",
    "\n",
    "                # 1. Precio ofertado vs costo esperado → diferencia absoluta y % desviación.\n",
    "                abs_deviation = np.abs(supplier_price - forecast_price)\n",
    "                perc_deviation = (abs_deviation / forecast_price) * 100 if forecast_price != 0 else 0\n",
    "\n",
    "                # 2. Rangos de confianza → si el precio ofertado cae dentro del intervalo del forecast\n",
    "                # (Aquí, asumimos que se refiere al CI del propio proveedor)\n",
    "                in_ci = (supplier_price >= ci_lower) and (supplier_price <= ci_upper)\n",
    "\n",
    "                all_supplier_daily_metrics.append({\n",
    "                    'Date': current_date,\n",
    "                    'Equipo': equipo,\n",
    "                    'Proveedor': supplier_name,\n",
    "                    'Precio_Proveedor': supplier_price,\n",
    "                    'Pronostico_Base': forecast_price,\n",
    "                    'Desviacion_Abs': abs_deviation,\n",
    "                    'Desviacion_Perc': perc_deviation,\n",
    "                    'CI_Inferior_Proveedor': ci_lower,\n",
    "                    'CI_Superior_Proveedor': ci_upper,\n",
    "                    'Dentro_CI_Proveedor': in_ci\n",
    "                })\n",
    "\n",
    "    if all_supplier_daily_metrics:\n",
    "        detailed_supplier_metrics_df = pd.DataFrame(all_supplier_daily_metrics)\n",
    "\n",
    "        # 3. Ranking objetivo → ordena proveedores por menor desviación respecto al pronóstico.\n",
    "        # Menor Desviacion_Abs es mejor (Rank 1)\n",
    "        detailed_supplier_metrics_df['Rank_Desviacion'] = detailed_supplier_metrics_df.groupby(['Date', 'Equipo'])['Desviacion_Abs'].rank(method='min').astype(int)\n",
    "\n",
    "        print(\"\\n--- Métricas Diarias y Ranking de Proveedores Simulado ---\\n\")\n",
    "        # Display the full detailed DataFrame, sorted for clarity\n",
    "        display(detailed_supplier_metrics_df.sort_values(by=['Date', 'Equipo', 'Rank_Desviacion']).head(20)) # Show top 20 rows for example\n",
    "\n",
    "        print(\"\\nNota: La 'Consistencia histórica' requeriría datos históricos reales de precios de cada proveedor para su evaluación, lo cual no está disponible en la simulación actual.\")\n",
    "    else:\n",
    "        print(\"No se generaron métricas detalladas de proveedores.\")\n"
   ]
  },
