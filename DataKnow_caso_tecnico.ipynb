   "source": [
    "# Asegurarse de que no haya valores nulos en las columnas reales antes de la evaluación\n",
    "# Esto es crucial si el merge no encontró todas las fechas reales\n",
    "full_rolling_evaluation_df.dropna(subset=['Price_Y', 'Price_Z', 'Price_Equipo1', 'Price_Equipo2'], inplace=True)\n",
    "\n",
    "if full_rolling_evaluation_df.empty:\n",
    "    print(\"No hay datos disponibles para la evaluación en el DataFrame completo.\")\n",
    "else:\n",
    "    # Obtener todos los años únicos presentes en el DataFrame de evaluación\n",
    "    unique_years = full_rolling_evaluation_df['Date'].dt.year.unique()\n",
    "    unique_years.sort()\n",
    "\n",
    "    # DataFrame para almacenar todas las métricas\n",
    "    all_metrics = []\n",
    "\n",
    "    print(\"\\n--- Métricas de Evaluación para todos los Años ---\")\n",
    "    for year in unique_years:\n",
    "        evaluation_year_df = full_rolling_evaluation_df[\n",
    "            full_rolling_evaluation_df['Date'].dt.year == year\n",
    "        ].copy()\n",
    "\n",
    "        if evaluation_year_df.empty:\n",
    "            print(f\"  No hay datos para el año {year}. Saltando.\")\n",
    "            continue\n",
    "\n",
    "        # Calcular MSE y MAPE para Price_Y\n",
    "        mse_y = mean_squared_error(evaluation_year_df['Price_Y'], evaluation_year_df['Price_Y_forecast'])\n",
    "        mape_y = mean_absolute_percentage_error(evaluation_year_df['Price_Y'], evaluation_year_df['Price_Y_forecast']) * 100\n",
    "\n",
    "        # Calcular MSE y MAPE para Price_Z\n",
    "        mse_z = mean_squared_error(evaluation_year_df['Price_Z'], evaluation_year_df['Price_Z_forecast'])\n",
    "        mape_z = mean_absolute_percentage_error(evaluation_year_df['Price_Z'], evaluation_year_df['Price_Z_forecast']) * 100\n",
    "\n",
    "        # Calcular MSE y MAPE para Price_Equipo1\n",
    "        mse_eq1 = mean_squared_error(evaluation_year_df['Price_Equipo1'], evaluation_year_df['Price_Equipo1_forecast'])\n",
    "        mape_eq1 = mean_absolute_percentage_error(evaluation_year_df['Price_Equipo1'], evaluation_year_df['Price_Equipo1_forecast']) * 100\n",
    "\n",
    "        # Calcular MSE y MAPE para Price_Equipo2\n",
    "        mse_eq2 = mean_squared_error(evaluation_year_df['Price_Equipo2'], evaluation_year_df['Price_Equipo2_forecast'])\n",
    "        mape_eq2 = mean_absolute_percentage_error(evaluation_year_df['Price_Equipo2'], evaluation_year_df['Price_Equipo2_forecast']) * 100\n",
    "\n",
    "        # Almacenar los resultados\n",
    "        all_metrics.append({\n",
    "            'Año': year,\n",
    "            'Price_Y_MSE': f'{mse_y:.2f}',\n",
    "            'Price_Y_MAPE': f'{mape_y:.2f}%',\n",
    "            'Price_Z_MSE': f'{mse_z:.2f}',\n",
    "            'Price_Z_MAPE': f'{mape_z:.2f}%',\n",
    "            'Price_Equipo1_MSE': f'{mse_eq1:.2f}',\n",
    "            'Price_Equipo1_MAPE': f'{mape_eq1:.2f}%',\n",
    "            'Price_Equipo2_MSE': f'{mse_eq2:.2f}',\n",
    "            'Price_Equipo2_MAPE': f'{mape_eq2:.2f}%'\n",
    "        })\n",
    "\n",
    "    # Mostrar la tabla de métricas\n",
    "    metrics_df = pd.DataFrame(all_metrics)\n",
    "    display(metrics_df)\n"
   ]
